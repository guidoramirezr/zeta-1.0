# Copia este archivo como .env.local y completa los valores. .env.local nunca se sube a Git.

# Clave de API de Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Modelo de Claude (opcional). Por defecto: claude-opus-5-5
# ZETA_AI_MODEL=claude-opus-5-5

# Consultas con IA por día (opcional). Se renuevan a medianoche (hora de Ecuador).
# ZETA_LIMIT_ANON=5
# ZETA_LIMIT_FREE=20
# ZETA_LIMIT_PRO=200

# Base de datos (Supabase → Connect → Transaction pooler)
DATABASE_URL=

# Panel admin: correos con acceso (separados por coma)
ZETA_ADMIN_EMAILS=

# Correo para enviar el código de acceso en producción (resend.com)
# RESEND_API_KEY=
# ZETA_EMAIL_FROM=Zeta <codigos@tudominio.com>
